# Database Configuration (for local development)
LOCAL_DB_HOST=localhost
LOCAL_DB_NAME=blogdb
LOCAL_DB_USER=your_db_user
LOCAL_DB_PASSWORD=your_db_password

# Flask Configuration
FLASK_ENV=development

# External API Keys
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token
RESEND_API_KEY=your_resend_api_key

# Clerk Authentication
# CLERK_SECRET_KEY: Backend JWT verification using RS256 algorithm (keep secure, never commit actual value)
# CLERK_PUBLISHABLE_KEY: Frontend ClerkProvider initialization (safe to expose, but still use .env)
# CLERK_WEBHOOK_SECRET_KEY: Webhook signature validation (optional, only if using Clerk webhooks)
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_WEBHOOK_SECRET_KEY=your_clerk_webhook_secret

# cPanel Deployment (Production Only)
CPANEL_USERNAME=your_cpanel_username
CPANEL_API_KEY=your_cpanel_api_key
SERVER_IP_ADDRESS=your_server_ip
SSH_PRIVATE_KEY_PATH=path/to/your/ssh/key
SSH_PORT=22
