# API Base URL
VITE_API_BASE_URL=http://localhost:5000

# Clerk Authentication
# VITE_CLERK_PUBLISHABLE_KEY: Enables Clerk React SDK for user authentication
# Safe to expose in browser (public key), but keep in .env for configuration consistency
# Must match CLERK_PUBLISHABLE_KEY from backend .env (same Clerk application)
VITE_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
