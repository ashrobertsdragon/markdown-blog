{
  "name": "blog-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "homepage": ".",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit --project tsconfig.app.json",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test e2e/",
    "test:acceptance": "playwright test acceptance/",
    "test:all": "vitest run && playwright test",
    "lint": "biome check --write . && tsc --noEmit --project tsconfig.app.json",
    "lint:ci": "biome ci . && tsc --noEmit --project tsconfig.app.json",
    "clean": "rm -rf ../build coverage"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.59.3",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@tanstack/react-query": "^5.100.10",
    "@uiw/react-md-editor": "^4.0.11",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.9.6",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-sanitize": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.2",
    "@clerk/testing": "^2.1.7",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/react-query-devtools": "^5.100.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.10",
    "autoprefixer": "^10.4.22",
    "jose": "^6.1.3",
    "jsdom": "^27.2.0",
    "npm-check-updates": "^19.1.2",
    "postcss": "^8.5.6",
    "shadcn": "^3.6.3",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.10"
  }
}
